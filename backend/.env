# ── App ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:5173,https://carmarket.com

# ── Database (MongoDB via Prisma) ──────────────────────────────────────────
# Prisma requires MongoDB to run as a replica set (even a single-node one) to
# support transactions, used when placing an order. Start local MongoDB with:
#   mongod --replSet rs0 --dbpath <your-db-path>
# then, once it's up, initiate it once via mongosh:
#   mongosh --eval "rs.initiate({_id: 'rs0', members: [{ _id: 0, host: 'localhost:27017' }]})"
DATABASE_URL=mongodb://localhost:27018/carmarket?replicaSet=rs0&directConnection=true

# ── Auth ─────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=devsecretaccess1234567890
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=devsecretrefresh1234567890
JWT_REFRESH_EXPIRES_IN=7d

# ── Payments ─────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
PAYPAL_CLIENT_ID=xxx
PAYPAL_CLIENT_SECRET=xxx

# ── Storage / Uploads ────────────────────────────────────────────────────
UPLOAD_DRIVER=local
UPLOAD_DIR=uploads
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Mail ─────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@carmarket.com

# ── Rate limiting ────────────────────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=100
